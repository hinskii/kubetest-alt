[
  {
    "name": "First load: entry JavaScript (brotli)",
    "path": "../internal/controlcenter/webui/dist/assets/index-*.js",
    "limit": "150 kB"
  },
  {
    "name": "CodeMirror, loaded on demand (brotli)",
    "path": [
      "../internal/controlcenter/webui/dist/assets/codemirror-*.js",
      "../internal/controlcenter/webui/dist/assets/yaml-view-*.js"
    ],
    "limit": "150 kB"
  },
  {
    "name": "The editor's languages (JS, Python, XML), loaded on demand (brotli)",
    "path": "../internal/controlcenter/webui/dist/assets/code-editor-*.js",
    "limit": "60 kB"
  },
  {
    "name": "Analytics with Recharts, loaded on demand (brotli)",
    "path": "../internal/controlcenter/webui/dist/assets/_name_.analytics-*.js",
    "limit": "100 kB"
  },
  {
    "name": "All JavaScript (brotli)",
    "path": "../internal/controlcenter/webui/dist/assets/*.js",
    "limit": "500 kB"
  },
  {
    "name": "CSS (brotli)",
    "path": "../internal/controlcenter/webui/dist/assets/*.css",
    "limit": "15 kB"
  }
]
