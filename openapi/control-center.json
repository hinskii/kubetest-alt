{
  "components": {
    "schemas": {
      "Capabilities": {
        "properties": {
          "delete": {
            "type": "boolean"
          },
          "run": {
            "type": "boolean"
          }
        },
        "required": [
          "run",
          "delete"
        ],
        "type": "object"
      },
      "Cluster": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reachable": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "displayName",
          "reachable"
        ],
        "type": "object"
      },
      "Commit": {
        "properties": {
          "sha": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "sha"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Me": {
        "properties": {
          "can": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "enum": [
              "viewer",
              "developer",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "email",
          "role",
          "can"
        ],
        "type": "object"
      },
      "Param": {
        "properties": {
          "default": {
            "type": "string"
          },
          "enum": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "required"
        ],
        "type": "object"
      },
      "RunPage": {
        "properties": {
          "next": {
            "type": "string"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunRow"
            },
            "type": "array"
          }
        },
        "required": [
          "runs"
        ],
        "type": "object"
      },
      "RunRef": {
        "properties": {
          "finishedAt": {
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "phase"
        ],
        "type": "object"
      },
      "RunRequest": {
        "properties": {
          "config": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "notBefore": {
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "RunRow": {
        "properties": {
          "comment": {
            "type": "string"
          },
          "commit": {
            "$ref": "#/components/schemas/Commit"
          },
          "createdBy": {
            "type": "string"
          },
          "durationMs": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "notBefore": {
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          },
          "phase": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "phase"
        ],
        "type": "object"
      },
      "Schedule": {
        "properties": {
          "error": {
            "type": "string"
          },
          "expr": {
            "type": "string"
          },
          "next": {
            "items": {
              "format": "date-time",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "expr",
          "next"
        ],
        "type": "object"
      },
      "ScheduleResult": {
        "properties": {
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          }
        },
        "type": "object"
      },
      "ScheduleUpdate": {
        "properties": {
          "schedule": {
            "type": "string"
          }
        },
        "required": [
          "schedule"
        ],
        "type": "object"
      },
      "StartedRun": {
        "properties": {
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "notBefore": {
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "name",
          "namespace"
        ],
        "type": "object"
      },
      "TestDetail": {
        "properties": {
          "definition": {
            "type": "string"
          },
          "locked": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "params": {
            "items": {
              "$ref": "#/components/schemas/Param"
            },
            "type": "array"
          },
          "problem": {
            "type": "string"
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "templates": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "namespace",
          "tool",
          "locked",
          "templates",
          "params",
          "definition"
        ],
        "type": "object"
      },
      "TestList": {
        "properties": {
          "tests": {
            "items": {
              "$ref": "#/components/schemas/TestSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "tests"
        ],
        "type": "object"
      },
      "TestSummary": {
        "properties": {
          "latestRun": {
            "$ref": "#/components/schemas/RunRef"
          },
          "locked": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "namespace",
          "tool",
          "locked"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Control Center's backend for its UI. Signed-in identity comes from the sign-in proxy's header; clusters are reached through the Kubernetes service proxy.",
    "title": "kubetest Control Center",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/clusters": {
      "get": {
        "operationId": "listClusters",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Cluster"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Configured clusters, each probed now, in config order."
      }
    },
    "/api/v1/clusters/{cluster}/tests": {
      "get": {
        "operationId": "listTests",
        "parameters": [
          {
            "in": "path",
            "name": "cluster",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestList"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "Every Test in the cluster, by namespace and name."
      }
    },
    "/api/v1/clusters/{cluster}/tests/{ns}/{name}": {
      "delete": {
        "description": "Requires the admin role.",
        "operationId": "deleteTest",
        "parameters": [
          {
            "in": "path",
            "name": "cluster",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Conflict"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "Delete a GUI-managed Test; its run history stays."
      },
      "get": {
        "operationId": "getTest",
        "parameters": [
          {
            "in": "path",
            "name": "cluster",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestDetail"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "A Test with its templates merged: parameters, schedule, definition."
      }
    },
    "/api/v1/clusters/{cluster}/tests/{ns}/{name}/runs": {
      "get": {
        "operationId": "listTestRuns",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cluster",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPage"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "One page of a Test's runs, newest first."
      },
      "post": {
        "description": "Requires the developer role.",
        "operationId": "startRun",
        "parameters": [
          {
            "in": "path",
            "name": "cluster",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedRun"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "Start a run of the Test, now or at notBefore."
      }
    },
    "/api/v1/clusters/{cluster}/tests/{ns}/{name}/schedule": {
      "put": {
        "description": "Requires the developer role.",
        "operationId": "setSchedule",
        "parameters": [
          {
            "in": "path",
            "name": "cluster",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResult"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Conflict"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "Set (or, with \"\", remove) a GUI-managed Test's recurring schedule."
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "The signed-in user and what their role allows."
      }
    }
  }
}
