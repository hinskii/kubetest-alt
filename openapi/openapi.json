{
  "components": {
    "schemas": {
      "Error": {
        "properties": {
          "message": {
            "type": "string"
          },
          "reason": {
            "description": "Machine-readable classifier: NotFound, BadRequest, Conflict, ManagedByGitOps, Internal, ServiceUnavailable.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "RunEnvelope": {
        "properties": {
          "durationMs": {
            "type": "integer"
          },
          "finishedAt": {
            "format": "date-time",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "origin": {
            "description": "Where the record came from — cluster runs are still mutable via kubectl; archive runs are read-only history.",
            "enum": [
              "cluster",
              "archive"
            ],
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "queuedAt": {
            "format": "date-time",
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          },
          "testRef": {
            "type": "string"
          },
          "uid": {
            "type": "string"
          }
        },
        "required": [
          "uid",
          "name",
          "namespace",
          "testRef",
          "phase",
          "origin"
        ],
        "type": "object"
      },
      "Test": {
        "description": "A Test CRD object.",
        "required": [
          "metadata",
          "spec"
        ],
        "type": "object"
      },
      "TestRun": {
        "description": "A TestRun CRD object.",
        "required": [
          "metadata",
          "spec"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Thin REST/WS API the GUI consumes. Reads flow through a controller-runtime shared informer cache; writes go directly to the k8s API server (§CLAUDE.md §7). §7 managed-by policy is enforced here for PATCH/DELETE on Tests; TestRun creation is always allowed regardless of the referenced Test's ownership.",
    "title": "kubetest-alt API",
    "version": "v1alpha1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Liveness probe."
      }
    },
    "/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 spec."
          }
        },
        "summary": "This spec."
      }
    },
    "/runs": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunEnvelope"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunEnvelope"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Merged list of active (cluster) and archived (store) runs, deduped by UID, sorted by startedAt DESC."
      },
      "parameters": [
        {
          "description": "Target namespace. Required for single-object requests when the server runs cluster-wide; optional (and must match) when it is scoped. On list endpoints, omitting it on a cluster-wide server lists all namespaces.",
          "in": "query",
          "name": "namespace",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestRun"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestRun"
                }
              }
            },
            "description": "OK"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestRun"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Create a TestRun. spec.source is set server-side to \"ui\" — payload override rejected 400. Allowed regardless of the referenced Test's managed-by label (§7 lets GUI trigger runs on gitops-owned Tests)."
      }
    },
    "/runs/{id}": {
      "delete": {
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Delete a finished run from history: its objects (logs, artifacts, result.json), its CR if present, and its store row. 409 while the run is live (abort it first). Idempotent per step; safe to retry."
      },
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunEnvelope"
                }
              }
            },
            "description": "OK"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunEnvelope"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get a single run by CR name (active) or UID (archived)."
      },
      "parameters": [
        {
          "description": "TestRun name (cluster) or UID (archive).",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target namespace. Required for single-object requests when the server runs cluster-wide; optional (and must match) when it is scoped. On list endpoints, omitting it on a cluster-wide server lists all namespaces.",
          "in": "query",
          "name": "namespace",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/runs/{id}/abort": {
      "parameters": [
        {
          "description": "TestRun name.",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target namespace. Required for single-object requests when the server runs cluster-wide; optional (and must match) when it is scoped. On list endpoints, omitting it on a cluster-wide server lists all namespaces.",
          "in": "query",
          "name": "namespace",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "message": {
                    "maxLength": 512,
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunEnvelope"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Abort a live run. Sets spec.abort (reason User, requestedBy from the X-Kubetest-User header); the controller kills the Job, records the run as aborted, persists it and fires webhooks. Idempotent. Allowed on runs of GitOps-managed Tests (runs are not definitions, §7)."
      }
    },
    "/runs/{id}/artifacts": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "contentType": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "sizeBytes": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "path"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List the run's artifacts (recorded refs; falls back to listing the run's artifacts/ prefix when none were recorded)."
      },
      "parameters": [
        {
          "description": "TestRun name or UID.",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target namespace. Required for single-object requests when the server runs cluster-wide; optional (and must match) when it is scoped. On list endpoints, omitting it on a cluster-wide server lists all namespaces.",
          "in": "query",
          "name": "namespace",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/runs/{id}/artifacts/{path}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "expiresIn": {
                      "type": "integer"
                    },
                    "url": {
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "expiresIn"
                  ],
                  "type": "object"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Artifact bytes, or {url, expiresIn} with ?presign=1."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Stream an artifact's bytes (default; served with nosniff + CSP sandbox, ?download=1 for attachment), or with ?presign=1 return a presigned object-store URL. Path traversal (../, absolute paths, backslashes) rejected 400."
      },
      "parameters": [
        {
          "description": "TestRun name or UID.",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Relative artifact path (e.g. results/junit.xml).",
          "in": "path",
          "name": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target namespace. Required for single-object requests when the server runs cluster-wide; optional (and must match) when it is scoped. On list endpoints, omitting it on a cluster-wide server lists all namespaces.",
          "in": "query",
          "name": "namespace",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/runs/{id}/logs": {
      "get": {
        "responses": {
          "101": {
            "description": "Switching Protocols (WebSocket)."
          },
          "400": {
            "description": "Namespace missing or outside the server's scope."
          },
          "404": {
            "description": "Run not found in the cluster or the archive."
          },
          "503": {
            "description": "Log storage not configured."
          }
        },
        "summary": "Stream logs over WebSocket. Live runs poll the MinIO chunk prefix every ~1s; archived runs stream all chunks then close. Binary WS frames = raw log bytes."
      },
      "parameters": [
        {
          "description": "TestRun name or UID.",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target namespace. Required for single-object requests when the server runs cluster-wide; optional (and must match) when it is scoped. On list endpoints, omitting it on a cluster-wide server lists all namespaces.",
          "in": "query",
          "name": "namespace",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/runs/{id}/logs.txt": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Log text."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "The run's whole stored log as text/plain (live runs: what has been flushed so far, no follow). ?download=1 adds Content-Disposition: attachment."
      },
      "parameters": [
        {
          "description": "TestRun name or UID.",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target namespace. Required for single-object requests when the server runs cluster-wide; optional (and must match) when it is scoped. On list endpoints, omitting it on a cluster-wide server lists all namespaces.",
          "in": "query",
          "name": "namespace",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
